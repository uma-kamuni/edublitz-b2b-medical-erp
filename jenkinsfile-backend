pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_credential = credentials('aws-access')
        ECR_USER = '876358614994.dkr.ecr.eu-north-1.amazonaws.com/user-service'
        ECR_PRODUCT = '876358614994.dkr.ecr.eu-north-1.amazonaws.com/product-service'
        ECR_ORDER = '876358614994.dkr.ecr.eu-north-1.amazonaws.com/order-service'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/uma-kamuni/edublitz-b2b-medical-erp.git'
            }
        }

        stage('Build USER-SERVICE') {
            steps {
                dir('user-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQube Analysis - USER-SERVICE') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('user-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        // stage('Quality Gates USER-SERVICE') {
        //     steps {
