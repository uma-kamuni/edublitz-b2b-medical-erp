        stage('Build ORDER-SERVICE') {
            steps {
                dir('order-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'order-service/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQubeAnalysis - ORDER-SERVICE') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('order-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        // stage('Quality Gates ORDER-SERVICE') {
        //     steps {
        //         timeout(time: 5, unit: 'MINUTES'){
        //             waitForQualityGate abortPipeline: true
        //         }
        //     }
        // }

        stage('Docker Build') {
            steps {
                sh '''
                docker rmi -f $(docker images -q)
                docker build -t user-service:${BUILD_NUMBER} ./user-service
                docker build -t product-service:${BUILD_NUMBER} ./product-service 
                docker build -t order-service:${BUILD_NUMBER} ./order-service
                docker images
                '''
            }
        }

        // stage('Trivy image scanning') {
        //     steps {
        //         sh '''
        //           trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 user-service:${BUILD_NUMBER}
        //           trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 product-service:${BUILD_NUMBER}
        //           trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 order-service:${BUILD_NUMBER}
        //         '''
        //     }
        // }

        stage('Push images to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region eu-north-1 | docker login --username AWS --password-stdin 876358614994.dkr.ecr.eu-north-1.amazonaws.com

                docker tag user-service:${BUILD_NUMBER} ${ECR_USER}:${BUILD_NUMBER}
                docker push ${ECR_USER}:${BUILD_NUMBER}

                docker tag product-service:${BUILD_NUMBER} ${ECR_PRODUCT}:${BUILD_NUMBER}
                docker push ${ECR_PRODUCT}:${BUILD_NUMBER}

                docker tag order-service:${BUILD_NUMBER} ${ECR_ORDER}:${BUILD_NUMBER}
                docker push ${ECR_ORDER}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update Manifest') {
            steps {
                sh '''
                    sed -i "s|image: .*|image: ${ECR_USER}:${BUILD_NUMBER}|" k8s/deployments/user-service-deployment.yaml
                    sed -i "s|image: .*|image: ${ECR_PRODUCT}:${BUILD_NUMBER}|" k8s/deployments/product-service-deployment.yaml
                    sed -i "s|image: .*|image: ${ECR_ORDER}:${BUILD_NUMBER}|" k8s/deployments/order-service-deployment.yaml
                '''
            }
        }

        stage("Push changes to GITHUB"){
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "github-cred",
                        usernameVariable: "GIT_USERNAME",
                        passwordVariable: "GIT_PASSWORD"
                    )
                ]) {

                    sh '''
                        git config user.name "uma-kamuni"
                        git config user.email "kamuniumaramesh@gmail.com"

                        git add k8s/deployments/user-service-deployment.yaml
                        git add k8s/deployments/product-service-deployment.yaml
                        git add k8s/deployments/order-service-deployment.yaml
                        git commit -m "update deployments"
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/uma-kamuni/edublitz-b2b-medical-erp.git HEAD:dev
                    '''
                }
            }
        }

        // stage('Deploy to k8s') {
